{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**", ".idea/**"]
}
